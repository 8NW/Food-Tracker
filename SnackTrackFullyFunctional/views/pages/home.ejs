								<h5 class="card-title" style="justify-content:center; text-align:center;">No Households Yet :(</h5>
							</div>
							</div>
							</div>
						</div>
					<%}%>
			</div>
		</div>
		<div class="col">
			<% console.log(color); %>
			<% if(color){ %>
				<% var script_text = '<script>document.body.style.backgroundColor = "#' + color + '";</script>'; %>
				<%- script_text %>
			<% }%>
		</div>
	</div>
</div>

