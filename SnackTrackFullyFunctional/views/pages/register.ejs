<%- include('../partials/header') %>

	<br>

	<div class="container">
		<form action="/register" method="post" >
			<div class="form-group row">
				<label class="col-sm-2 col-form-label" for="fullName">First Name</label>
				<div class="col-sm-10">
					<input type="text" class="form-control" name="first_name" id="fullName"  placeholder="Enter First Name" required>
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label" for="fullName">Last Name</label>
				<div class="col-sm-10">
					<input type="text" class="form-control" name="last_name" id="fullName"  placeholder="Enter Last Name" required>
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label"  for="emailAddress">Username</label>
				<div class="col-sm-10">
					<input type="text" class="form-control" name="username" id="emailAddress" placeholder="Enter Username" required>
				</div>
			</div>
			<div class="form-group row">
				<label  class="col-sm-2 col-form-label" for="passwordFirst">Password</label>
				<div class="col-sm-10">
					<input type="password" onkeyup="myFunction()" id="password" class="form-control" name="password" placeholder="Password" required>
				</div>
			</div>
			<div class="form-group row">
				<label  class="col-sm-2 col-form-label" for="passwordConfirm">Confirm Password</label>
				<div class="col-sm-10">
					<input  type="password" onkeyup="myFunction()" id="passwordconfirm" class="form-control" name="passwordConfirm" placeholder="Confirm Password" required>
				</div>
			</div>
			<input disabled type="submit"  id="button" value="submit" class="btn btn-primary btn-block">
			<div id="warningdiv" class="form-group row" style="margin-top: 2.5vh">
				<div class="col-sm-4">

				</div>
				<div class="col-sm-4" style="background-color:white; justify-content: center; text-align: center;  border: 2px solid black;">
					<h5 style="color:red" id = "warning">Passwords Must Match!</h5>
				</div>
				<div class="col-sm-4">

				</div>
			</div>
			<div id="emptywarningdiv" class="form-group row" style="margin-top: 2.5vh">
				<div class="col-sm-4">

				</div>
				<div class="col-sm-4" style="background-color:white; justify-content: center; text-align: center;  border: 2px solid black;">
					<h5 style="color:red" id = "emptywarning">Password Must Be At Least 8 Characters</h5>
				</div>
				<div class="col-sm-4">

				</div>
			</div>
		</form>
		<br>
	</div>

	<script>
		
		function myFunction() {
			var password = document.getElementById("password");
			var confpassword = document.getElementById("passwordconfirm");
			var passEqualsConfPass = (password.value).localeCompare(confpassword.value);
			
			if(passEqualsConfPass == 0 && password.value.length > 7 && confpassword.value.length > 7)
			{
				document.getElementById("button").disabled = false;
				document.getElementById("emptywarning").style.visibility = "hidden";
				document.getElementById("emptywarningdiv").style.visibility = "hidden";
				document.getElementById("warning").style.visibility = "hidden";
				document.getElementById("warningdiv").style.visibility = "hidden";
			}
			else if(passEqualsConfPass != 0 && (password.value.length <= 7 && confpassword.value.length <= 7))
			{
				document.getElementById("button").disabled = true;
				document.getElementById("emptywarning").style.visibility = "visible";
				document.getElementById("emptywarningdiv").style.visibility = "visible";
				document.getElementById("warning").style.visibility = "visible";
				document.getElementById("warningdiv").style.visibility = "visible";
			}
			else if(passEqualsConfPass != 0 && (password.value.length > 7 || confpassword.value.length > 7))
			{
				document.getElementById("button").disabled = true;
				document.getElementById("emptywarning").style.visibility = "hidden";
				document.getElementById("emptywarningdiv").style.visibility = "hidden";
				document.getElementById("warning").style.visibility = "visible";
				document.getElementById("warningdiv").style.visibility = "visible";
			}
			else if(passEqualsConfPass == 0 && ((password.value.length <= 7 && confpassword.value.length <= 7)))
			{
				document.getElementById("button").disabled = true;
				document.getElementById("emptywarning").style.visibility = "visible";
				document.getElementById("emptywarningdiv").style.visibility = "visible";
				document.getElementById("warning").style.visibility = "hidden";
				document.getElementById("warningdiv").style.visibility = "hidden";
			}
		}
		
	</script>
<%- include('../partials/footer') %>