<%- include('../partials/header') %>
	

    <style>
      .bd-placeholder-img {
        font-size: 1.125rem;
        text-anchor: middle;
      }

      @media (min-width: 768px) {
        .bd-placeholder-img-lg {
          font-size: 3.5rem;
        }
      }


    </style>
	

    <form autocomplete="off" class="form-signin" action="/auth" method="post" id="Signin">
	<header class="ST-Title">SnackTrack</header>
	<br>
	  
	  <input type="text" id="inputUsername" class="form-control" name="username" placeholder="Username" required autofocus>
	  <label for="inputPassword" class="sr-only" name="passwordLabel">Password</label>
	  <input type="password" id="inputPassword" name = "password" class="form-control" placeholder="Password" required>
	  <button class="btn btn-lg btn-primary" style="margin-left: 17%;" type="submit">Sign in</button>
	  <a class="btn btn-lg btn-primary" href="register">Register</a>
    
    <% if(failed == true)
   {%>
    <div id="popupDiv" style="text-align: center; margin-top: 5%;" >
      <div class="popup" id="notadded">
          <span class="popuptext" id="myPopup" style="text-align: center; color: red; font-family: 'Times New Roman', Times, serif; font-size: large;">Error Logging In</span>
        </div>
        <script>
          const myTimeout = setTimeout(dummy, 3000);
    
          function dummy() {
            document.getElementById("notadded").innerHTML = '';
            document.getElementById("popupDiv").style="margin-top: 0%; margin-bottom: 0%;";
            document.getElementById("popupDiv").innerHTML='';
          }
        </script>
    </div>
   <%}%>
	</form>
	<!-- Because we now use partials for our header, we can't directly add Boostrap Classes to our Body tag.
		 Below is a "work-around" to apply the Bootstrap classes when the page loads
	 -->
	<script type="text/javascript">
        function addCSSToBody() {
            document.body.classlist.add("center");
            document.body.classlist.add("text-center");
        }
        window.onload = addCSSToBody;

	</script>
<%- include('../partials/footer') %>