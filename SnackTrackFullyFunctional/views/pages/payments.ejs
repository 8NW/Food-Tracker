<%- include('../partials/header') %>
<%- include('../partials/menu') %>

<% console.log(color); %>
<% if(color){ %>
	<% var script_text = '<script>document.body.style.backgroundColor = "#' + color + '";</script>'; %>
    <%- script_text %>
<% }%>

<% console.log(color); %>
<% if(color){ %>
	<% var script_text = '<script>document.getElementById("head").style.backgroundColor = "#' + color + '";</script>'; %>
    <%- script_text %>
<% }%>

<div class="container-fluid">
	<div class="row" style="padding-top: 2.5vh;">
		<div class="col">

		</div>
		<div class="col-8" style="background: #FAF9F6;">
			<div class="row" style="padding-top: 1.5vh; padding-bottom: 1.5vh; border-bottom: 2px solid #86b9bd; max-height: 8vh;">
				<div class="col-3">
					<h4  style="text-align:start; color:gray; font-weight: bolder;">Requests</h4>
				</div>
				<div class="col6">
					
				</div>
				<div class="col-9" >
					
				</div>
				<div class="col">

				</div>
			</div>
			<div class="containerScroll__payments" style="padding-top: 1vh; padding-bottom: 2.5 vh;">
				
				<% if(data) 
          		{  
              
					var i = 0;
					data.forEach(function(item)
					{  
						
						if(userid == parseInt(item.send_id) && 0 == parseInt(item.request))
						{
							i = i + 1;
						%>
						<div class = card style ="width: 100%;">
							<div class="card-header">
								<%-item.receivername%> has requested $<%-(parseFloat(item.amnt)).toFixed(2)%> 
								<form action="/payments/payrequest" method="post" id="playerinfo_form-2">
									<input type="submit" style="width: auto;"  value="Make Requested Payment">
									<input style="visibility:hidden" id="receive" name="trans_id" value = "<%- item.trans_id %>">
								  </form>
							</div>				
							<h5 class="card-title" style="text-align:center"> <%- item.transdesc %> </h5>
							<p class="card-text" style="text-align:right"> <%- (String(item.t_date)).substring(0, 15) %></p>
						</div>
						<%
						}
						}); 
              
					}
					if(i == 0)
					{ %>
						<div class="card mb-3" style="max-width: 100%; max-height: 20%; padding-top: 2vh; padding-bottom: 2vh; ">
						<div class="row no-gutters">
							<div class="col-md-2">
							</div>
							<div class="col-md-8" style="justify-content:center; text-align:center ">
							<div class="card-body">
								<h5 class="card-title" style="justify-content:center; text-align:center;">No Current Requests</h5>
							</div>
							</div>
							</div>
						</div>
					<%}%>
			</div>
			<!--<div style="padding-top: 1vh; padding-bottom: 1vh; display: flex; justify-content: space-evenly; align-items: center; max-height: 6vh;">
				<button type="button" class="btn btn-primary btn-lg" style="background-color: #86b9bd; border: 1px solid lightgray;"> Make Payment </button>
				<button type="button" class="btn btn-primary btn-lg" style="background-color: #86b9bd; border: 1px solid lightgray;"> Request Payment </button>
			</div> --->
		</div>
		<div class="col">

		</div>
	</div>
</div>


<div class="container-fluid" id="hist" style="margin-top: 3%; margin-bottom: 3%;">
<% console.log(color); %>
<% if(color){ %>
	<% var script_text = '<script>document.getElementById("hist").style.backgroundColor = "#' + color + '";</script>'; %>
    <%- script_text %>
<% }%>
	<div class="row" style="padding-top: 2.5vh; padding-bottom: 2.5vh;">
		<div class="col">

		</div>
		<div class="col-8" style="background: #FAF9F6;">
			<div class="row" style="padding-top: 1.5vh; padding-bottom: 1.5vh; border-bottom: 2px solid #86b9bd; max-height: 8vh;">
				<div class="col-3">
					<h4  style="text-align:start; color:gray; font-weight: bolder;">Payment History</h4>
				</div>
				<div class="col6">
					
				</div>
				<div class="col-9" >
			
				</div>
				<div class="col">

				</div>
			</div>
			<div class="containerScroll__payments" style="padding-top: 1vh; padding-bottom: 2.5 vh;">
				
				<% if(data) 
          		{  
              
					var i = 0;
					data.forEach(function(item)
					{  
						i = i + 1;
						
						if(userid == parseInt(item.receive_id) && 1 == parseInt(item.request))
						{
						%>
						<div class = card style ="width: 100%;">
							<div class="card-header">
								<%-item.sendername%> paid you $<%-(parseFloat(item.amnt)).toFixed(2)%> 
							</div>				
							<h5 class="card-title" style="text-align:center"> <%- item.transdesc %> </h5>
							<p class="card-text" style="text-align:right"> <%- (String(item.t_date)).substring(0, 15) %></p>
						</div>
						<%
						}
						else if(userid == parseInt(item.send_id) && 1 == parseInt(item.request))
						{
						%>
						<div class = card style ="width: 100%;">
							<div class="card-header">
								You paid <%- item.receivername%> $<%-(parseFloat(item.amnt)).toFixed(2)%>
							</div>				
							<h5 class="card-title" style="text-align:center"> <%- item.transdesc %> </h5>
							<p class="card-text" style="text-align:right"> <%- (String(item.t_date)).substring(0, 15) %></p>
						</div>
						<% }}); 
              
					}
					if(i == 0)
					{ %>
						<div class="card mb-3" style="max-width: 100%; max-height: 20%; padding-top: 2vh; padding-bottom: 2vh; ">
						<div class="row no-gutters">
							<div class="col-md-2">
							</div>
							<div class="col-md-8" style="justify-content:center; text-align:center ">
							<div class="card-body">
								<h5 class="card-title" style="justify-content:center; text-align:center;">No Transaction History</h5>
							</div>
							</div>
							</div>
						</div>
					<%}%>
			</div>
			<!--<div style="padding-top: 1vh; padding-bottom: 1vh; display: flex; justify-content: space-evenly; align-items: center; max-height: 6vh;">
				<button type="button" class="btn btn-primary btn-lg" style="background-color: #86b9bd; border: 1px solid lightgray;"> Make Payment </button>
				<button type="button" class="btn btn-primary btn-lg" style="background-color: #86b9bd; border: 1px solid lightgray;"> Request Payment </button>
			</div> --->
		</div>
		<div class="col">

		</div>
	</div>
</div>


